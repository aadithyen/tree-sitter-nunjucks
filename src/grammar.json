        {
          "type": "SYMBOL",
          "name": "float"
        }
      ]
    },
    "member_expression": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "object",
