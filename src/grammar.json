      ]
    },
    "_nunjucks_comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{#"
        },
        {
          "type": "PATTERN",
          "value": "(([^#]|#[^}])*)#+}"
