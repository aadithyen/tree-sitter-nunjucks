          "type": "STRING",
          "value": "="
        },
        {
          "type": "FIELD",
          "name": "value",
          "content": {
            "type": "SYMBOL",
            "name": "_expr"
          }
        }
      ]
    },
    "_text": {
      "type": "PATTERN",
      "value": "([^{]|[{][^{%#])+"
