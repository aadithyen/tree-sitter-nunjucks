          }
        ]
      }
    },
    "_nunjucks_value": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{{"
        },
        {
          "type": "SYMBOL",
          "name": "_expr"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "nunjucks_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{%"
        },
        {
          "type": "PATTERN",
          "value": "([^%]|%[^}])*%}"
